# Editor defaults. clang-format owns C++ layout; this covers what it does not
# and every file it never sees.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in markdown.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
