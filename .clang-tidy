# Static analysis for everything outside the legacy tree, which carries its own
# override in src/.clang-tidy and tests/.clang-tidy.
#
# The exclusions are the checks that argue with this project's style rather
# than finding defects in it; everything else stays on, and new code is clean
# from its first line.
Checks: >
  -*,
  bugprone-*,
  cppcoreguidelines-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers
WarningsAsErrors: "*"
# include/ is legacy and is not checked; new headers live under libs/.
HeaderFilterRegex: "^libs/"
